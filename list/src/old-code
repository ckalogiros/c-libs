#include "linked_list.h"
#include <stdio.h>
#include <stdlib.h>
#include "mem_man.h"
#define MIN_LIST_CAPACITY 16

typedef struct {
    struct list_node_t *prev;
    struct list_node_t *next;
} prev_next_node_t;

static const char *single_linked_list = "single_linked_list";
static int32 unique_id                = 1;

static void linked_list_reset_node(struct list_node_t *const node)
{
    node->exists = FALSE;
    node->next   = NULL;
    node->id     = 0;
}

static struct list_node_t *linked_list_find_next_free_node(struct list_node_t *const list_node)
{
    // loop through the allocated memory as if it where a buffer
    for (uint32 i = 0; i < MIN_LIST_CAPACITY; i++)
    {
        struct list_node_t *next_free = list_node + i;
        if (next_free->exists != TRUE)
        {
            return next_free;
        }
    }
    // case list is full
    // todo: implement realloc
    return NULL;
}

static prev_next_node_t linked_list_find_node_by_data(struct list_node_t *const node, const uint32 data)
{
    struct list_node_t *prev_node = node;
    struct list_node_t *cur_node  = node->next;
    while (cur_node != NULL)
    {
        if (cur_node->data == data)
        {
            return (prev_next_node_t){prev_node, cur_node};
        }
        prev_node = cur_node;
        cur_node  = cur_node->next;
    }
    return (prev_next_node_t){NULL, NULL};
}

static prev_next_node_t linked_list_find_node_by_id(struct list_node_t *const node, const uint16 id)
{
    struct list_node_t *prev_node = node;
    struct list_node_t *cur_node  = node->next;
    while (cur_node != NULL)
    {
        if (cur_node->id == id)
        {
            return (prev_next_node_t){prev_node, cur_node};
        }
        prev_node = cur_node;
        cur_node  = cur_node->next;
    }
    return (prev_next_node_t){NULL, NULL};
}

static void linked_list_print_node(const struct list_node_t *const node, const char *const name)
{
    if (node)
    {
        printf("node_id:%d data=%d exists:%d next:%x\n", node->id, node->data, node->exists, node->next);
    }
}

