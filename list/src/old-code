bool linked_list_delete_by_data(const uint32 data, struct list_node_t *head)
{
    if (head == NULL) return FALSE; // case list is empty
    // case head is the element to delete
    if (head->data == data)
    {
        linked_list_reset_node(head);
        head->data = 0;
        if (head->next != NULL)
        {
            head = head->next; //  the next list element is now the head
        }
        return TRUE;
    }
    // else: continue searching
    prev_next_node_t found = linked_list_find_node_by_data(head, data);
    if (found.next != NULL)
    {
        if (found.prev != NULL) found.prev->next = found.next->next; //  connect previous with next
        linked_list_reset_node(found.next);
        found.next->data = 0;
    }

    return FALSE;
}

