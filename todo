Option 2: GCC vector extension
c

// GCC/Clang specific
void memset64(void *dest, uint64_t pattern, size_t count) {
    typedef uint64_t v2u64 __attribute__((vector_size(16)));
    v2u64 *d = dest;
    v2u64 p = {pattern, pattern};
    
    size_t i;
    for (i = 0; i + 1 < count; i += 2) {
        d[i/2] = p;
    }
    // Handle remainder
    if (i < count) {
        ((uint64_t *)d)[i] = pattern;
    }
}

----------------
Option 4: SIMD intrinsics (x86-64)
c

#include <immintrin.h>

void memset64_avx(void *dest, uint64_t pattern, size_t count) {
    uint64_t *d = dest;
    __m256i p = _mm256_set1_epi64x(pattern);
    
    size_t i = 0;
    for (; i + 3 < count; i += 4) {
        _mm256_storeu_si256((__m256i*)&d[i], p);
    }
    // Handle remainder
    for (; i < count; i++) {
        d[i] = pattern;
    }
}

----------------
Option 5: Assembly (x86-64)
c

void memset64_asm(void *dest, uint64_t pattern, size_t count) {
    uint64_t *d = dest;
    
    __asm__ volatile (
        "rep stosq"
        : "+D"(d), "+c"(count)
        : "a"(pattern)
        : "memory"
    );
}

