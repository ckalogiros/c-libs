----------------
Performance test comparison:
c

#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <time.h>

#define SIZE (1024*1024*16)  // 16 million elements

void benchmark() {
    uint64_t *data = malloc(SIZE * sizeof(uint64_t));
    uint64_t pattern = 0x123456789ABCDEF0ULL;
    
    // Method 1: Standard memset (byte-oriented, WRONG for pattern!)
    clock_t start = clock();
    memset(data, (int)pattern, SIZE * sizeof(uint64_t));
    clock_t end = clock();
    printf("memset: %.3f ms (WRONG - only sets bytes to 0xF0)\n", 
           (double)(end - start) * 1000 / CLOCKS_PER_SEC);
    
    // Method 2: Manual loop
    start = clock();
    for (size_t i = 0; i < SIZE; i++) {
        data[i] = pattern;
    }
    end = clock();
    printf("Manual loop: %.3f ms\n", 
           (double)(end - start) * 1000 / CLOCKS_PER_SEC);
    
    free(data);
}
